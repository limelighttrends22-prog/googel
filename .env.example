# Copy to .env locally. Placeholder values only. Never send secrets in chat.
# Empty OAuth values select local stdio using Application Default Credentials.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_MCP_BASE_URL=
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=
# HTTP requires filetree, redis or firestore (and the corresponding backend setup).
GOOGLE_ADS_MCP_STORAGE_TYPE=
GOOGLE_ADS_MCP_STORAGE_PATH=
GOOGLE_ADS_MCP_STORAGE_ENCRYPTION_KEY=
# Copy EXACT redirect URI from your ChatGPT MCP management page. No wildcards.
GOOGLE_ADS_MCP_ALLOWED_REDIRECT_URIS=
# Optional deployment restriction, comma-separated 10-digit advertiser IDs.
GOOGLE_ADS_MCP_ALLOWED_CUSTOMERS=
# Optional manager routing ID, 10 digits.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional legacy header only; tokens sunset September 2026. Access is now project-based.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Bind loopback by default; container deployments set 0.0.0.0 behind TLS ingress.
GOOGLE_ADS_MCP_HOST=127.0.0.1
PORT=8080
# Optional local SQLite path; defaults to ~/.google-ads-command-center/reports.sqlite3
GOOGLE_ADS_MCP_REPORT_DB=
